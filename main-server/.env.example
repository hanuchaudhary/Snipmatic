# Main Server Environment Variables
# Copy this file to .env and fill in your values

# Redis Configuration
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# Storage Configuration
STORAGE_BASE_PATH=/app/storage

# Email Server Configuration
EMAIL_SERVER_URL=http://email-server:

# Flower Configuration (Celery monitoring)
FLOWER_PORT=5555
FLOWER_BROKER=redis://redis:6379/0
FLOWER_BASIC_AUTH=admin:password

# AWS Configuration (for Clip Worker)
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your_bucket_name
CLOUDFRONT_URL=https://your-cloudfront-url.cloudfront.net

# AI Services Configuration (for Transcribe Worker)
GEMINI_API_KEY=your_gemini_api_key