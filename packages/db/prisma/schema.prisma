generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlanTier {
  FREE
  CLIP
  STUDIO
}

enum CreditTransactionType {
  SUBSCRIPTION_GRANT
  USAGE
  REFUND
  ADJUSTMENT
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String       @id @default(uuid())
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  role          Role         @default(USER)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  projects      Project[]
  billing       UserBilling?
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                    String    @id @default(uuid())
  type                  String    @default("oauth")
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  sessionState          String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model UserBilling {
  id                   String              @id @default(cuid())
  userId               String              @unique
  dodoCustomerId             String?        @unique
  dodoSubscriptionId         String?        @unique
  planTier             PlanTier            @default(FREE)
  creditsBalance       Int                 @default(30)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions         CreditTransaction[]
}

model CreditUsage {
  id          String  @id @default(cuid())
  userId      String
  amount      Int
  description String?
  metadata    Json?
  jobId       String
}

model CreditTransaction {
  id              String                @id @default(cuid())
  userId          String
  billingId       String
  amount          Int
  type            CreditTransactionType
  description     String?
  metadata        Json?
  jobId           String?
  billingEventId  String?               @unique
  createdAt       DateTime              @default(now())
  billing         UserBilling           @relation(fields: [billingId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum VideoSource {
  YOUTUBE
  UPLOAD
}

enum ProcessingType {
  AI
  MANUAL
}

enum ProjectStatus {
  QUEUED
  DOWNLOADING
  PREPROCESSING
  TRANSCRIBING
  DIARIZING
  DETECTING_FACES
  TRACKING
  ANALYZING
  FINDING_CLIPS
  COMPLETED
  FAILED
}

model Project {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String?

  status   ProjectStatus @default(QUEUED)
  progress Int           @default(0)
  error    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  config   ProjectConfig?
  metadata ProjectMetadata?
  clips    Clip[]

  @@index([userId, createdAt])
  @@index([status])
}

model ProjectConfig {
  projectId        String         @id
  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  processingType   ProcessingType
  fromDuration     Float
  toDuration       Float
  duration         Float
  prompt           String?
  aspectRatio      String
  subtitlesEnabled Boolean        @default(false)
  subtitleStyleKey String?
}

model ProjectMetadata {
  projectId     String      @id
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source        VideoSource
  sourceUrl     String?
  sourceKey     String?
  thumbnailKey  String?
  transcriptKey String?
  audioKey      String?
  proxyKey      String?

  @@index([source])
}

model Clip {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  from Float
  to   Float

  duration Float
  score Float?

  title String?

  subtitlesKey String?
  outputKey    String
  thumbnailKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, createdAt])
  @@unique([projectId, outputKey])
}

// TODO
model Preset {
  id   String @id @default(cuid())
  name String

  thumbnailUrl String?
  config       Json // TODO: add type

  isActive Boolean @default(true)
  isPublic Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
